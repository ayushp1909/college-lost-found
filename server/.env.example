# Server Port
PORT=5000

# MongoDB Connection String (e.g., mongodb://localhost:27017/college_lost_found or MongoDB Atlas URI)
MONGO_URI=

# JWT Secret Key for signing tokens
JWT_SECRET=

# Cloudinary Credentials for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API Key for text embeddings
GEMINI_API_KEY=

# AI Semantic Matching Threshold (0.0 to 1.0)
AI_MATCH_THRESHOLD=0.80